<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_text_program"
            android:textSize="22sp"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/sn_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_sn"
            android:inputType="text"
            android:singleLine="true" />
        <EditText
            android:id="@+id/ip_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_ip"
            android:inputType="text"
            android:singleLine="true" />
        <EditText
            android:id="@+id/user_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_user"
            android:inputType="text"
            android:singleLine="true" />
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <EditText
                android:id="@+id/password_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_password"
                android:inputType="textPassword"
                android:paddingEnd="48dp"
                android:singleLine="true" />

            <ImageButton
                android:id="@+id/password_visibility_toggle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="4dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/toggle_password_visibility"
                android:padding="8dp"
                android:src="@drawable/ic_eye_open"
                android:tint="#888888" />
        </FrameLayout>
        <EditText
            android:id="@+id/text_input"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:gravity="top|start"
            android:hint="@string/hint_text"
            android:inputType="textMultiLine" />
        <EditText
            android:id="@+id/program_width_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_program_width"
            android:inputType="number"
            android:singleLine="true" />
        <EditText
            android:id="@+id/program_height_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_program_height"
            android:inputType="number"
            android:singleLine="true" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:labelFor="@id/font_family_spinner"
                android:text="@string/font_family_label" />
            <Spinner
                android:id="@+id/font_family_spinner"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:labelFor="@id/font_size_spinner"
                android:text="@string/font_size_label" />
            <Spinner
                android:id="@+id/font_size_spinner"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/send_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/send_button_background"
                android:minHeight="48dp"
                android:textColor="@android:color/white"
                android:text="@string/send" />

            <Button
                android:id="@+id/send_doc_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/send_button_background"
                android:minHeight="48dp"
                android:textColor="@android:color/white"
                android:text="@string/send_doc_example" />

            <Button
                android:id="@+id/send_picture_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/send_button_background"
                android:minHeight="48dp"
                android:textColor="@android:color/white"
                android:text="@string/send_picture" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/log_title"
            android:textStyle="bold" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:orientation="horizontal">

            <ScrollView
                android:id="@+id/log_scroll"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/log_box_background"
                android:fadeScrollbars="false"
                android:fillViewport="true"
                android:scrollbarSize="6dp"
                android:scrollbarStyle="insideInset"
                android:scrollbarThumbVertical="@drawable/log_scrollbar_thumb"
                android:scrollbars="vertical">
            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:textIsSelectable="true" />
            </ScrollView>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <Button
                    android:id="@+id/log_scroll_up"
                    android:layout_width="42dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:padding="0dp"
                    android:text="▲"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/log_scroll_down"
                    android:layout_width="42dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:padding="0dp"
                    android:text="▼"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
